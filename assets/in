#!/bin/sh

# Resource Impl: http://concourse.ci/implementing-resources.html#in:-fetch-a-given-resource
set -e

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

# Resolve our own directory up front so helper lookups do not depend on cwd.
assets_dir="$(cd "$(dirname "$0")" && pwd)"

dest=$1

if [ -z "$dest" ]; then
  echo "usage: $0 <path/to/volume>"
  exit 1
fi
#######################################

# parse incoming config data
payload=`cat`
bucket=$(echo "$payload" | jq -r '.source.bucket')
path=$(echo "$payload" | jq -r '.source.path // ""')
options=$(echo "$payload" | jq -r '.source.options // [] | join(" ")')

# export for `aws` cli
AWS_ACCESS_KEY_ID=$(echo "$payload" | jq -r '.source.access_key_id // empty')
AWS_SECRET_ACCESS_KEY=$(echo "$payload" | jq -r '.source.secret_access_key // empty')
AWS_DEFAULT_REGION=$(echo "$payload" | jq -r '.source.region // empty')

# Due to precedence rules, must be unset to support AWS IAM Roles.
if [ -n "$AWS_ACCESS_KEY_ID" ] && [ -n "$AWS_SECRET_ACCESS_KEY" ]; then
  export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
  export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
fi

# Export AWS_DEFAULT_REGION if set
if [ -n "$AWS_DEFAULT_REGION" ]; then
  export AWS_DEFAULT_REGION
fi

echo "Downloading from S3..."
eval aws s3 sync "s3://$bucket/$path" $dest $options
echo "...done."

# Echo back the version we were asked to fetch. Concourse rejects an empty
# version (`{}`), and `get` must report the same version it was given so that
# version history and `passed:` constraints line up.
version="$(echo "$payload" | jq -c '.version // empty')"
if [ -z "$version" ] || [ "$version" = "{}" ]; then
  # Fetched without a version (e.g. a put-only resource, or the very first
  # get): fall back to the bucket's current version.
  recent="$("$assets_dir/version.sh" "$bucket" "$path")"
  if [ -z "$recent" ]; then
    echo "warning: no objects under s3://$bucket/$path; emitting a synthetic version" >&2
    recent="$(jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{LastModified: $ts}')"
  fi
  version="$recent"
fi

echo "$version" | jq -c '{version: .}' >&3
